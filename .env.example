# --- OMNI (Qwen3.5-Omni via yibuapi) -----------------------------------
# Check https://yibuapi.com/pricing and the API key email you received for
# the exact base URL / model name. Most resellers of this kind expose an
# OpenAI-compatible /v1/chat/completions endpoint - that's what main.py
# assumes below. If yibuapi's docs show something different (a different
# path, a different content-block shape for audio/image), update the
# call_omni() function in main.py - that's the ONLY place you should need
# to touch for this.
OMNI_BASE_URL=https://api.yibuapi.com
OMNI_API_KEY=sk-BdMbRIcHWyYapARTDMh7V3as6rVBOkjAoY1eh0VleauRpLeg
OMNI_MODEL=qwen3.5-omni

# --- Zip (procurement) --------------------------------------------------
# Base URL + key for the Zip company they set you up with at the event.
# Check the Zip REST API docs / Postman collection they hand out for the
# real endpoint paths and payload field names - update call_zip() in
# main.py accordingly. This scaffold assumes a fairly standard
# "create purchase request" REST resource.
ZIP_BASE_URL=https://api.ziphq.com
ZIP_API_KEY=REPLACE_ME

PORT=3000
