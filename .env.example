# --- Zip (procurement) --------------------------------------------------
# Base URL + key for the Zip company they set you up with at the event.
# Check the Zip REST API docs / Postman collection they hand out for the
# real endpoint paths and payload field names - update call_zip() in
# main.py accordingly. This scaffold assumes a fairly standard
# "create purchase request" REST resource.
ZIP_BASE_URL=https://api.ziphq.com
ZIP_API_KEY=REPLACE_ME

PORT=3000

# Luxonis OAK camera: max USB speed (HIGH = USB2, the safe default; SUPER = USB3)
# OAK_MAX_USB=HIGH
